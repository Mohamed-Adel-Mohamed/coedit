# ── CoEdit local configuration ────────────────────────────────────────────────
NODE_ENV=development

# Collaboration server (REST + WebSocket)
PORT=8787
APP_ORIGINS=http://localhost:3000

# PostgreSQL. The bundled dev cluster listens on 55433.
DATABASE_URL=postgres://postgres@127.0.0.1:55433/coedit

# Optional. Without it the server uses an in-process pub/sub bus (single instance).
# With it, presence + document updates fan out across server instances.
# REDIS_URL=redis://127.0.0.1:6379

# At least 32 characters. Rotate this outside development.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_HOURS=12
WS_TICKET_TTL_SECONDS=90

# Snapshot cadence for the version history
SNAPSHOT_INTERVAL_MS=60000
SNAPSHOT_MAX_UPDATES=200
ROOM_IDLE_MS=45000

LOG_LEVEL=info
AUTO_MIGRATE=true

# Web app (server-side API calls)
API_URL=http://127.0.0.1:8787
WS_URL=ws://localhost:8787/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws
