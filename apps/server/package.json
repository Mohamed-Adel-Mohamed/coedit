{
  "name": "@coedit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coedit/shared": "*",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "lib0": "0.2.120",
    "pg": "^8.23.1",
    "pino": "^10.1.0",
    "ws": "^8.23.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
